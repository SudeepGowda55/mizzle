{
  "name": "mizzle",
  "version": "1.1.0",
  "description": "Shows others on a video call that you're about to speak, from the breath you take before talking (Presage SmartSpectra)",
  "scripts": {
    "probe": "node --env-file=.env probe.mjs",
    "questions": "QUESTIONS=1 node --env-file=.env probe.mjs",
    "test": "node --test test/*.test.js",
    "replay": "node scripts/replay.mjs",
    "start": "node scripts/write-config.mjs && electron .",
    "config": "node scripts/write-config.mjs",
    "dist": "node scripts/write-config.mjs && electron-builder --mac --arm64"
  },
  "keywords": [],
  "author": "Sudeep Gowda",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/gabarito": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@smartspectra/node-sdk": "3.5.0",
    "mqtt": "5.16.1"
  },
  "main": "main.js",
  "devDependencies": {
    "electron": "38.2.0",
    "electron-builder": "26.18.0"
  },
  "productName": "Mizzle",
  "build": {
    "appId": "dev.sudeepgowda.mizzle",
    "productName": "Mizzle",
    "asar": false,
    "files": [
      "main.js",
      "preload.cjs",
      "src/**",
      "ui/**",
      "app-config.json",
      "package.json",
      "!node_modules/@smartspectra/node-sdk-linux-*/**",
      "!node_modules/@smartspectra/node-sdk-win32-*/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Mizzle reads your breathing from the camera, on this Mac, to let your call know you are about to speak. Video never leaves your computer."
      }
    },
    "dmg": {
      "title": "Mizzle"
    }
  },
  "private": true
}
